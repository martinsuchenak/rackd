# Release image, built by GoReleaser (dockers_v2) from the binaries the
# release already produced: no compiling here. To build from source, use
# Dockerfile instead.
FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/rackd /usr/local/bin/rackd

WORKDIR /app
RUN mkdir -p /data

# Mount a volume at /data to keep the database.
ENV DATA_DIR=/data
ENV LISTEN_ADDR=:8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:8080/healthz || exit 1

ENTRYPOINT ["rackd"]
CMD ["server"]
