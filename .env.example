# Core settings
DATA_DIR=./data
LISTEN_ADDR=:8080
LOG_FORMAT=text
LOG_LEVEL=info

# Credential encryption (64 hex chars = 32 bytes). Required in production to
# encrypt stored SNMP/SSH credentials and DNS provider tokens at rest.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Security (both enabled by default — disable for local dev over plain HTTP)
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Set to false when developing locally without TLS
# COOKIE_SECURE=false

# Trusted reverse proxies (comma-separated IPs/CIDRs). Required when
# TRUST_PROXY=true: forwarded client-IP headers (X-Forwarded-For, X-Real-IP)
# are honored ONLY when the direct peer matches one of these networks.
# Without this, rate-limit keys fall back to the socket address (fail-closed).
# TRUSTED_PROXIES=10.0.0.5,10.0.1.0/24

# Outbound integration SSRF policy (webhooks, DNS provider endpoints).
# Default false: requests to loopback, link-local (cloud metadata), multicast
# and private ranges (RFC1918, CGNAT 100.64/10, ULA) are rejected — including
# hostnames that resolve into those ranges. Set to true only when integrations
# must deliberately target internal services.
# SSRF_ALLOW_PRIVATE_TARGETS=false

# Discovery
DISCOVERY_INTERVAL=24h
DISCOVERY_MAX_CONCURRENT=10
DISCOVERY_TIMEOUT=5s
DISCOVERY_CLEANUP_DAYS=30
DISCOVERY_SCAN_ON_STARTUP=false
